<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>A captured email, SMS or share. The body stored here is ALREADY MASKED by the Cloudflare Worker - unmasked text never reaches Salesforce. Bodies are blanked after RawBodyRetentionDays.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Inbound Message</label>
    <nameField>
        <displayFormat>MSG-{0000}</displayFormat>
        <label>Inbound Message Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Inbound Messages</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
