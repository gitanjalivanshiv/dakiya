<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Confirmation__c</fullName>
    <description>Gitanjali's own confirmation, which is the thing that actually matters. A courier saying 'delivered' only sets this to Pending.</description>
    <label>Confirmation</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>true</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Received</fullName>
                    <default>false</default>
                    <label>Received</label>
                </value>
                <value>
                    <fullName>Not Received</fullName>
                    <default>false</default>
                    <label>Not Received</label>
                </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
